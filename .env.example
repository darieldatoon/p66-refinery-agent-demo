# Two LangSmith keys on purpose. Do not collapse them.

# Tracing, deployment, Context Hub: Deployed Engineering / Dariel Dato-on workspace
# (the `de` profile in the langsmith CLI).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=f56bee33-7a4a-4f21-90ea-f6c8cc25ab68

# Local runs trace to the -local project. The deployment traces to its own project,
# named after the deployment, so this line is for `mda dev` only. `mda deploy` forwards
# .env as hosted secrets; keep this here anyway, the platform sets the project for
# deployed runs.
LANGSMITH_PROJECT=refinery-reliability-agent-local

# Model calls: LangChain Inc. LLM Gateway, workspace-scoped service key exported in the
# shell as LC_GATEWAY_KEY. Paste its literal value here for deployment forwarding.
LANGSMITH_GATEWAY_API_KEY=
AGENT_MODEL=langsmith:openai/gpt-6-sol
